spring:
  datasource:
    url: jdbc:postgresql://localhost:5432/skeletoni
    username: user
    password: password

  data:
    mongodb:
      uri: mongodb://root:rootpassword@localhost:27017/skeletoni?authSource=admin
    couchbase:
      connection-string: localhost
      user-name: admin
      password: password
      bucket-name: skeletoni

  kafka:
    bootstrap-servers: localhost:9092
    properties:
      schema.registry.url: http://localhost:8085

  rabbitmq:
    username: user
    password: password
